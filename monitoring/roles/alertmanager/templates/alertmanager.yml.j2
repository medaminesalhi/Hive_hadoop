route:
  receiver: default-receiver

receivers:
  - name: default-receiver
{% if alerting.slackEnabled %}
    slack_configs:
      - api_url: "{{ alerting.slackWebhook }}"
        channel: "{{ alerting.slackChannel }}"
        send_resolved: true
{% endif %}
{% if alerting.emailEnabled %}
    email_configs:
      - to: "{{ alerting.emailTo }}"
        from: "{{ alerting.emailFrom }}"
        smarthost: "{{ alerting.smtpHost }}:{{ alerting.smtpPort }}"
        send_resolved: true
{% endif %}