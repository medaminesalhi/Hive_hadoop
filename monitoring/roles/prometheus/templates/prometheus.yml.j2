global:
  scrape_interval: {{ prometheus_cfg.scrapeInterval }}
  evaluation_interval: {{ prometheus_cfg.evaluationInterval }}

scrape_configs:
  - job_name: node_exporter
    static_configs:
      - targets:
{% for target in node_exporter_targets %}
          - "{{ target }}"
{% endfor %}

{% if jmx_hdfs_targets is defined and jmx_hdfs_targets | length > 0 %}
  - job_name: jmx_exporter_hdfs
    static_configs:
      - targets:
{% for target in jmx_hdfs_targets %}
          - "{{ target }}"
{% endfor %}
{% elif jmx_targets is defined and jmx_targets | length > 0 %}
  - job_name: jmx_exporter_hdfs
    static_configs:
      - targets:
{% for target in jmx_targets %}
          - "{{ target }}"
{% endfor %}
{% endif %}

{% if jmx_yarn_targets is defined and jmx_yarn_targets | length > 0 %}
  - job_name: jmx_exporter_yarn
    static_configs:
      - targets:
{% for target in jmx_yarn_targets %}
          - "{{ target }}"
{% endfor %}
{% endif %}

{% if stack.alertmanager %}
alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - "127.0.0.1:9093"
{% endif %}